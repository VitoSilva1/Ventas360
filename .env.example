# ============================================================
# Ventas 360 — Variables de entorno para docker-compose
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env está en .gitignore — nunca lo comitees.
#
#   cp .env.example .env
#   (editar .env con los valores reales)
#   docker-compose up --build
# ============================================================

# --- Google OAuth ---
# Client ID de tipo "Web application" generado en Google Cloud Console.
# El mismo valor se usa en el backend (auth-service) y en el build del frontend.
# No es un secret — pero tampoco debe commitearse si contiene un Client ID real.
GOOGLE_OAUTH_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# --- Base de datos ---
# Usuario y contraseña de PostgreSQL. Valores por defecto: postgres / postgres.
DB_USERNAME=postgres
DB_PASSWORD=postgres
